# Get your API key from https://developers.aptoslabs.com
# Copy this file to .env.local and replace the value below.
VITE_SHELBYNET_API_KEY=aptoslabs_your_key_here
VITE_SHELBY_TESTNET_API_KEY=aptoslabs_your_key_here

# Optional fallback for older local setups.
VITE_APTOS_API_KEY=aptoslabs_your_key_here

# Shelby test network
VITE_SHELBY_NETWORK=shelbynet

# Deploy move/ package, then set the publishing account address here.
VITE_BLOBSAFE_CONTRACT_ADDRESS=0xyour_contract_address
VITE_BLOBSAFE_SHELBYNET_CONTRACT_ADDRESS=0xyour_shelbynet_contract_address
VITE_BLOBSAFE_TESTNET_CONTRACT_ADDRESS=0xyour_testnet_contract_address

# Optional: record the external Shelby S3 Gateway endpoint displayed in Settings.
# Do not put S3 signing secrets in VITE_* env vars; browser env is public.
# For local gateway quick start, use http://localhost:9000.
VITE_SHELBY_S3_GATEWAY_URL=http://localhost:9000

# Local-only shell variables for `npm run s3:validate`.
# Keep these in your terminal or a private local script, not in frontend env.
# SHELBY_S3_GATEWAY_URL=http://localhost:9000
# SHELBY_S3_BUCKET=0xyour_wallet_address
# SHELBY_S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# SHELBY_S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# BLOBSAFE_S3_PREFIX=blobsafe/
# BLOBSAFE_S3_OBJECT_KEY=blobsafe/public/example.png
