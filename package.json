{
  "name": "blobsafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "s3:validate": "node tools/s3/validate-s3.mjs",
    "move:compile": "aptos move compile --package-dir move --named-addresses blobsafe_addr=%BLOBSAFE_ADDR%",
    "move:test": "aptos move test --package-dir move --named-addresses blobsafe_addr=%BLOBSAFE_ADDR%",
    "move:publish": "aptos move publish --package-dir move --named-addresses blobsafe_addr=%BLOBSAFE_ADDR%",
    "move:init": "aptos move run --function-id %BLOBSAFE_ADDR%::access_control::init"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^6.0.0",
    "@aptos-labs/wallet-adapter-react": "^7.0.0",
    "@shelby-protocol/react": "latest",
    "@shelby-protocol/sdk": "latest",
    "@tanstack/react-query": "^5.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.4.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vite": "^5.4.14"
  }
}
